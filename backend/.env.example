# ── Servidor ──────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Segurança ─────────────────────────────────
# Gere uma chave aleatória forte:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_AQUI

# ── Admin ─────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=TROQUE_SUA_SENHA_AQUI


# ── Barbearia ─────────────────────────────────
BARBEARIA_NOME=SC Barbearia
BARBEARIA_WHATSAPP=5534999999999
